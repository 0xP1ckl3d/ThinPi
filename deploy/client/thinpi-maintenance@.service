[Unit]
Description=ThinPi authorised local maintenance console for %i
After=systemd-user-sessions.service
Conflicts=getty@tty2.service

[Service]
Type=oneshot
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
ExecStartPre=/usr/bin/chvt 2
ExecStart=/usr/local/libexec/thinpi-maintenance-session %i
ExecStopPost=/usr/bin/chvt 7
TimeoutStartSec=infinity

[Install]
WantedBy=thinpi.target
