[Unit]
Description=ThinPi authorised local maintenance console for %i
After=systemd-user-sessions.service thinpi-ui.service
Requires=thinpi-ui.service

[Service]
Type=oneshot
User=%i
SupplementaryGroups=thinpi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/thinpi/maintenance.Xauthority
ExecStart=/usr/local/libexec/thinpi-maintenance-session %i
TimeoutStartSec=infinity

[Install]
WantedBy=thinpi.target
