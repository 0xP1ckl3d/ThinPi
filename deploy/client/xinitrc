#!/bin/sh
# shellcheck disable=SC3045
ulimit -c 0
xhost +SI:localuser:thinpi >/dev/null 2>&1 || true
xhost - >/dev/null 2>&1 || true
xset s off
xset s noblank

# Raspberry Pi OS uses a minimal PulseAudio server. The agent loads a sink for
# the currently selected physical ALSA device, bypassing unreliable KMS HDMI
# profile detection while retaining format conversion and multi-client mixing.
if grep -aq 'Raspberry Pi' /proc/device-tree/model 2>/dev/null; then
  if command -v pulseaudio >/dev/null 2>&1; then
    pulseaudio --check >/dev/null 2>&1 || \
      pulseaudio --start --file=/usr/local/libexec/thinpi-pulse.pa --exit-idle-time=-1 >/dev/null 2>&1 || true
  fi
else
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ "${1:-}" != "--session-bus" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" --session-bus
  fi
  if command -v systemctl >/dev/null 2>&1 && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service >/dev/null 2>&1 || true
  fi
fi

xbindkeys -n -f /usr/local/libexec/thinpi-xbindkeysrc &
matchbox-window-manager -use_titlebar no &
exec /usr/bin/thinpi-launcher
